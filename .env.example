# Oblivion runs with zero configuration and no API keys.
# Every variable below is optional; leave it blank to use the built-in defaults.

# Public Sepolia RPC endpoint used by the wallet (no key required).
VITE_SEPOLIA_RPC_URL=

# Extra Waku bootstrap peers, comma-separated (defaults to the public Waku network).
VITE_WAKU_BOOTSTRAP_PEERS=
